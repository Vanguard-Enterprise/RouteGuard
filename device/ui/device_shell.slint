        footer_color: root.footer_color;
        bar_fill: root.bar_fill;
    }
}

component LoginScreen inherits Rectangle {
    in property <string> pin_display: "* * * *";
    in property <string> error_message: "";
    in property <bool> active: true;
    in property <color> fill: #0d1a2d;
    in property <color> alt_fill: #091523;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> secondary_text: #8fa5c1;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    in property <color> accent_fill: #f4ab2a;
    in property <color> error_fill: #2b151a;
    in property <color> error_stroke: #8f434a;
    in property <color> error_text: #ffd2d6;
    callback append_digit(string);
    callback clear_requested();
    callback back_requested();

    private property <float> content_scale: max(0.64, min(1.08, min(self.width / 1440px, self.height / 900px)));
    private property <length> screen_padding: max(26px, 34px * content_scale);
    private property <length> logo_width: min(self.width - (screen_padding * 2), 320px * content_scale);
    private property <length> logo_height: max(56px, 74px * content_scale);
    private property <length> panel_width: min(self.width - (screen_padding * 2), max(760px, self.width * 0.54));
    private property <length> panel_height: min(self.height - (screen_padding * 2) - logo_height - (54px * content_scale), max(620px, self.height * 0.76));
    private property <length> header_top: max(screen_padding, self.height * 0.08);
    private property <length> panel_top: min(self.height - panel_height - screen_padding, header_top + logo_height + (36px * content_scale));

    background: transparent;

    Image {
        x: (parent.width - root.logo_width) / 2;
        y: root.header_top;
        width: root.logo_width;
        height: root.logo_height;
        source: @image-url("../assets/text-logo.png");
        image-fit: contain;
    }

    Text {
        x: root.screen_padding;
        y: root.header_top + root.logo_height + (10px * root.content_scale);
        width: parent.width - (root.screen_padding * 2);
        text: "Driver lockscreen";
        color: root.secondary_text;
        font-size: 18px * root.content_scale;
        font-weight: 700;
        horizontal-alignment: center;
    }

    LockCard {
        x: (parent.width - self.width) / 2;
        y: root.panel_top;
        width: root.panel_width;
        height: root.panel_height;
        pin_display: root.pin_display;
        error_message: root.error_message;
        active: root.active;
        fill: root.fill;
        alt_fill: root.alt_fill;
        stroke: root.stroke;
        primary_text: root.primary_text;
        panel_button_fill: root.panel_button_fill;
        panel_button_pressed_fill: root.panel_button_pressed_fill;
        panel_button_stroke: root.panel_button_stroke;
        accent_fill: root.accent_fill;
        error_fill: root.error_fill;
        error_stroke: root.error_stroke;
        error_text: root.error_text;
        append_digit(digit) => {
            root.append_digit(digit);
        }
        clear_requested => {
            root.clear_requested();
        }
        back_requested => {
            root.back_requested();
        }
    }
}

