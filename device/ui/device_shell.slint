component DemoBoardingScreen inherits Rectangle {
    in property <string> driver_label: "";
    in property <string> current_time_text: "";
    in property <bool> light_theme: false;
    in property <string> demo_status_title: "";
    in property <string> demo_status_body: "";
    in property <int> demo_total_count: 0;
    in property <[string]> demo_seat_names: [];
    in property <[string]> demo_seat_grades: [];
    in property <[int]> demo_seat_states: [];
    in property <int> demo_alert_kind: 0;
    in property <bool> demo_toast_visible: false;
    in property <color> fill: #0d1a2d;
    in property <color> alt_fill: #091523;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> secondary_text: #8fa5c1;
    in property <color> tertiary_text: #7f97b5;
    in property <color> accent_fill: #f4ab2a;
    in property <color> accent_pressed_fill: #d69718;
    in property <color> accent_text: #09111f;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    callback logout_requested();
    callback trigger_demo_scan(int);

    private property <float> content_scale: max(0.62, min(1.16, min(self.width / 1440px, self.height / 900px)));
    private property <length> edge_padding: max(8px, 10px * content_scale);
    private property <length> header_height: 32px * content_scale;
    private property <length> toast_height: 104px * content_scale;
    private property <length> section_gap: max(4px, 6px * content_scale);
    private property <length> action_height: max(42px, 46px * content_scale);
    private property <length> logout_width: max(152px, 172px * content_scale);
    private property <length> center_gap: max(28px, 34px * content_scale);
    private property <length> seat_panel_top: edge_padding + header_height + section_gap;
    private property <length> seat_panel_height: max(340px, self.height - seat_panel_top - action_height - (edge_padding * 0.5));
    private property <length> seat_panel_width: self.width - (edge_padding * 2);
    private property <length> seat_column_width: (seat_panel_width - center_gap) / 2;
    private property <length> seat_inset: 4px * content_scale;
    private property <length> center_line_inset: 6px * content_scale;
    private property <length> seat_height: min(172px * content_scale, (seat_panel_height - (seat_inset * 2) - (section_gap * 4)) / 5);
    private property <length> seat_gap: max(2px, (seat_panel_height - (seat_inset * 2) - (seat_height * 5)) / 4);
    private property <length> action_button_width: (self.width - (edge_padding * 2) - logout_width - (section_gap * 3)) / 3;
    private property <string> boarding_summary: demo_total_count + " waiting";
    private property <color> muted_text: light_theme ? #7890aa : #8da2bf;
    private property <color> panel_surface: light_theme ? #f3f7fc : alt_fill;
    private property <color> alert_color:
        demo_alert_kind == 1 ? #2bb673 :
        demo_alert_kind == 2 ? #e25555 :
        demo_alert_kind == 3 ? #3f8cff :
        accent_fill;

    background: transparent;

    Text {
        x: edge_padding;
        y: edge_padding + (2px * content_scale);
        width: 210px * content_scale;
        height: 34px * content_scale;
        text: current_time_text;
        color: primary_text;
        font-size: 31px * content_scale;
        font-weight: 800;
        vertical-alignment: center;
    }

    Text {
        x: (parent.width - (260px * content_scale)) / 2;
        y: edge_padding + (2px * content_scale);
        width: 260px * content_scale;
        text: boarding_summary;
        color: secondary_text;
        font-size: 24px * content_scale;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: parent.width - edge_padding - (180px * content_scale);
        y: edge_padding + (2px * content_scale);
        width: 180px * content_scale;
        text: "Bus 412";
        color: tertiary_text;
        font-size: 21px * content_scale;
        font-weight: 700;
        horizontal-alignment: right;
    }

    Rectangle {
        visible: root.demo_toast_visible && root.demo_alert_kind == 0;
        x: root.edge_padding + (16px * root.content_scale);
        y: root.seat_panel_top + (10px * root.content_scale);
        width: parent.width - (root.edge_padding * 2) - (32px * root.content_scale);
        height: root.toast_height;
        border-radius: 24px * root.content_scale;
        border-width: max(1px, root.content_scale * 1px);
        border-color: root.alert_color;
        background: light_theme ? #f8fbff : #122038;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 24px * root.content_scale;
        drop-shadow-offset-y: 8px * root.content_scale;
        z: 20;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 12px * root.content_scale;
            height: parent.height;
            border-radius: 24px * root.content_scale;
            background: root.alert_color;
        }

        Text {
            x: 30px * root.content_scale;
            y: 16px * root.content_scale;
            width: parent.width - (60px * root.content_scale);
            text: root.demo_status_title;
            color: root.primary_text;
            font-size: 24px * root.content_scale;
            font-weight: 800;
        }

        Text {
            x: 30px * root.content_scale;
            y: 50px * root.content_scale;
            width: parent.width - (60px * root.content_scale);
            text: root.demo_status_body;
            color: root.secondary_text;
            font-size: 19px * root.content_scale;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: edge_padding;
        y: seat_panel_top;
        width: seat_panel_width;
        height: seat_panel_height;
        border-radius: 24px * content_scale;
        border-width: max(1px, content_scale * 1px);
        border-color: light_theme ? #d7e1ee : panel_button_stroke;
        background: panel_surface;

        Rectangle {
            x: (parent.width - (4px * root.content_scale)) / 2;
            y: root.center_line_inset;
            width: 2px * root.content_scale;
            height: parent.height - (root.center_line_inset * 2);
            background: light_theme ? #d7e1ee : root.panel_button_stroke;
        }

        for row in [0, 1, 2, 3, 4] : Text {
            x: (parent.width - (24px * root.content_scale)) / 2;
            y: root.seat_inset + (20px * root.content_scale) + (row * (root.seat_height + root.seat_gap));
            width: 24px * root.content_scale;
            text: row + 1;
            color: root.muted_text;
            font-size: 16px * root.content_scale;
            font-weight: 700;
            horizontal-alignment: center;
        }

        for seat[index] in root.demo_seat_names : BusSeatCard {
            x: index < 5 ?
                root.seat_inset :
                parent.width - root.seat_column_width - root.seat_inset;
            y: root.seat_inset + (Math.mod(index, 5) * (root.seat_height + root.seat_gap));
            width: root.seat_column_width;
            height: root.seat_height;
            name_text: seat;
            grade_text: root.demo_seat_grades[index];
            seat_state: root.demo_seat_states[index];
            seat_label: index < 5 ? (index + 1) + "A" : (index - 4) + "B";
            scale: root.content_scale;
            stroke: light_theme ? #d7e1ee : root.panel_button_stroke;
            dark_fill: #16213a;
            dark_text: #f8fbff;
            light_text: light_theme ? #16213a : #f8fbff;
            muted_text: root.muted_text;
            success_fill: #dff4e8;
            success_text: #1f6a49;
            waiting_fill: light_theme ? #31384d : #2f3850;
            waiting_text: #f8fbff;
            absent_fill: #fbe1e7;
            absent_text: #b94d68;
        }
    }

    PrimaryAction {
        x: parent.width - logout_width - edge_padding;
        y: parent.height - action_height - edge_padding;
        width: logout_width;
        height: action_height;
        label: "Logout";
        active: true;
        fill: accent_fill;
        pressed_fill: accent_pressed_fill;
        stroke: accent_fill;
        text_color: accent_text;
        scale: content_scale;
        tapped => {
            root.logout_requested();
        }
    }

    Rectangle {
        visible: root.demo_toast_visible && root.demo_alert_kind != 0;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: root.alert_color;
        z: 30;

        Text {
            x: root.edge_padding;
            y: parent.height * 0.30;
            width: parent.width - (root.edge_padding * 2);
            height: parent.height * 0.22;
            text: root.demo_status_title;
            color: #ffffff;
            font-size: max(72px, 112px * root.content_scale);
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        Text {
            x: root.edge_padding;
            y: parent.height * 0.54;
            width: parent.width - (root.edge_padding * 2);
            height: parent.height * 0.30;
            text: root.demo_status_body;
            color: #ffffff;
            font-size: max(36px, 52px * root.content_scale);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component SettingsScreen inherits Rectangle {
    in property <int> orientation_mode: 0;
    in property <int> brightness_level: 100;
    in property <int> contrast_level: 100;
    in property <int> theme_mode: 0;
    in property <bool> demo_mode_enabled: false;
    in property <string> demo_success_tag: "";
    in property <string> demo_wrong_bus_tag: "";
    in property <string> demo_invalid_tag: "";
    in property <int> demo_capture_slot: -1;
    in property <color> fill: #0d1a2d;
    in property <color> alt_fill: #091523;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> secondary_text: #8fa5c1;
    in property <color> tertiary_text: #7f97b5;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    in property <color> accent_fill: #f4ab2a;
    in property <color> accent_pressed_fill: #d69718;
    in property <color> accent_text: #09111f;
    callback set_orientation(int);
    callback set_theme_mode(int);
    callback adjust_brightness(int);
    callback adjust_contrast(int);
    callback set_demo_mode_enabled(bool);
    callback adjust_demo_tag(int, int);
    callback clear_demo_tag(int);
    callback start_demo_tag_capture(int);
    callback close_requested();

    private property <float> content_scale: max(0.64, min(1.02, min(self.width / 1440px, self.height / 900px)));
    private property <length> screen_padding: max(18px, 24px * content_scale);

    background: transparent;

    SettingsPanel {
        x: root.screen_padding;
        y: root.screen_padding;
        width: parent.width - (root.screen_padding * 2);
        height: parent.height - (root.screen_padding * 2);
        orientation_mode: root.orientation_mode;
        brightness_level: root.brightness_level;
        contrast_level: root.contrast_level;
        theme_mode: root.theme_mode;
        demo_mode_enabled: root.demo_mode_enabled;
        demo_success_tag: root.demo_success_tag;
        demo_wrong_bus_tag: root.demo_wrong_bus_tag;
        demo_invalid_tag: root.demo_invalid_tag;
        demo_capture_slot: root.demo_capture_slot;
        fill: root.fill;
        alt_fill: root.alt_fill;
        stroke: root.stroke;
        primary_text: root.primary_text;
        secondary_text: root.secondary_text;
        tertiary_text: root.tertiary_text;
        panel_button_fill: root.panel_button_fill;
        panel_button_pressed_fill: root.panel_button_pressed_fill;
        panel_button_stroke: root.panel_button_stroke;
        accent_fill: root.accent_fill;
        accent_pressed_fill: root.accent_pressed_fill;
        accent_text: root.accent_text;
        set_orientation(mode) => {
            root.set_orientation(mode);
        }
        set_theme_mode(mode) => {
            root.set_theme_mode(mode);
        }
        adjust_brightness(delta) => {
            root.adjust_brightness(delta);
        }
        adjust_contrast(delta) => {
            root.adjust_contrast(delta);
        }
        set_demo_mode_enabled(enabled) => {
            root.set_demo_mode_enabled(enabled);
        }
        adjust_demo_tag(slot, delta) => {
            root.adjust_demo_tag(slot, delta);
        }
        clear_demo_tag(slot) => {
            root.clear_demo_tag(slot);
        }
        start_demo_tag_capture(slot) => {
            root.start_demo_tag_capture(slot);
        }
        close_requested => {
            root.close_requested();
        }
    }
}

export component DeviceShell inherits Window {
    title: "RouteGuard Bus";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 800px;
    min-height: 480px;
    full-screen: true;
    default-font-size: 18px;

    in-out property <int> auth_status: 0;
    in-out property <string> pin_buffer: "";
    in-out property <int> pin_length: 0;
    in-out property <string> error_message: "";
    in-out property <string> driver_name: "";
    in-out property <string> current_time_text: "";
    in-out property <bool> is_enrollment_required: false;
    in-out property <string> fatal_error: "";
    in-out property <bool> is_settings_open: false;
    in-out property <int> orientation_mode: 0;
    in-out property <int> brightness_level: 100;
    in-out property <int> contrast_level: 100;
    in-out property <int> theme_mode: 0;
    in-out property <bool> demo_mode_enabled: false;
    in-out property <string> demo_success_tag: "";
    in-out property <string> demo_wrong_bus_tag: "";
    in-out property <string> demo_invalid_tag: "";
    in-out property <string> demo_status_title: "";
    in-out property <string> demo_status_body: "";
    in-out property <int> demo_boarded_count: 0;
    in-out property <int> demo_total_count: 0;
    in-out property <int> demo_capture_slot: -1;
    in-out property <[string]> demo_students: [];
    in-out property <[string]> demo_seat_names: [];
    in-out property <[string]> demo_seat_grades: [];
    in-out property <[int]> demo_seat_states: [];
    in-out property <int> demo_alert_kind: 0;
    in-out property <bool> demo_toast_visible: false;

    callback append_digit(string);
    callback backspace();
    callback clear_pin();
    callback submit_pin();
    callback logout();
    callback open_settings();
    callback close_settings();
    callback set_orientation(int);
    callback set_theme_mode(int);
    callback adjust_brightness(int);
    callback adjust_contrast(int);
    callback set_demo_mode_enabled(bool);
    callback adjust_demo_tag(int, int);
    callback clear_demo_tag(int);
    callback start_demo_tag_capture(int);
    callback trigger_demo_scan(int);

    private property <bool> is_light_theme: theme_mode == 1;
    private property <bool> is_high_contrast: contrast_level >= 110;
    private property <bool> is_low_contrast: contrast_level <= 85;
    private property <bool> is_portrait: orientation_mode == 1 || orientation_mode == 3;
    private property <bool> is_landscape: !is_portrait;
    private property <bool> login_visible: auth_status == 2 || auth_status == 3;
    private property <bool> blocked_visible: auth_status == 0 || auth_status == 1;
    private property <bool> authenticated_visible: auth_status == 4;
    private property <string> pin_display:
        pin_length == 0 ? "* * * *" :
        pin_length == 1 ? "* o o o" :
        pin_length == 2 ? "* * o o" :
        pin_length == 3 ? "* * * o" :
        "* * * *";
    private property <string> orientation_label:
        orientation_mode == 1 ? "Portrait" :
        orientation_mode == 2 ? "Landscape Inverted" :
        orientation_mode == 3 ? "Portrait Inverted" :
        "Landscape";
    private property <string> blocked_title_text:
        auth_status == 0 ? "Starting RouteGuard" : (fatal_error != "" ? "Device unavailable" : "Device enrollment required");
    private property <string> blocked_body_text:
        auth_status == 0
            ? "Preparing the device shell and validating the stored RouteGuard credentials."
            : (fatal_error != ""
                ? fatal_error
                : "This bus computer is not enrolled yet. Claim it from the RouteGuard dashboard to enable driver PIN access.");
    private property <string> blocked_footer_text:
        fatal_error != "" ? "System identity repair is required before this device can enroll." : "The Slint shell will unlock automatically once enrollment completes.";
    private property <string> authenticated_driver_label: driver_name == "" ? "Driver session active" : driver_name;
    private property <length> landscape_view_width: root.width;
    private property <length> landscape_view_height: root.height;
    private property <length> portrait_view_width: root.height;
    private property <length> portrait_view_height: root.width;
    private property <angle> landscape_rotation: orientation_mode == 2 ? 180deg : 0deg;
    private property <angle> portrait_rotation: orientation_mode == 1 ? 90deg : 270deg;
    private property <float> landscape_scene_scale: max(0.64, min(1.18, min(landscape_view_width / 1440px, landscape_view_height / 900px)));
    private property <float> portrait_scene_scale: max(0.72, min(1.02, min(portrait_view_width / 1080px, portrait_view_height / 1920px)));
    private property <length> landscape_gutter: max(32px, 44px * landscape_scene_scale);
    private property <length> portrait_gutter: max(24px, 32px * portrait_scene_scale);
    private property <length> landscape_lock_width: min(landscape_view_width - (landscape_gutter * 2), max(700px, landscape_view_width * 0.44));
    private property <length> landscape_lock_height: min(landscape_view_height - (landscape_gutter * 2), max(540px, landscape_view_height * 0.62));
    private property <length> portrait_lock_width: min(portrait_view_width - (portrait_gutter * 2), max(620px, portrait_view_width * 0.68));
    private property <length> portrait_lock_height: min(portrait_view_height - (portrait_gutter * 2), max(720px, portrait_view_height * 0.66));
    private property <length> landscape_blocked_width: min(landscape_view_width - (landscape_gutter * 2), max(760px, landscape_view_width * 0.56));
    private property <length> landscape_blocked_height: min(landscape_view_height - (landscape_gutter * 2), max(400px, landscape_view_height * 0.48));
    private property <length> portrait_blocked_width: min(portrait_view_width - (portrait_gutter * 2), max(720px, portrait_view_width * 0.78));
    private property <length> portrait_blocked_height: min(portrait_view_height - (portrait_gutter * 2), max(560px, portrait_view_height * 0.34));
    private property <length> landscape_authenticated_width: min(landscape_view_width - (landscape_gutter * 2), max(980px, landscape_view_width * 0.72));
    private property <length> landscape_authenticated_height: min(landscape_view_height - (landscape_gutter * 2), max(640px, landscape_view_height * 0.80));
    private property <length> portrait_authenticated_width: min(portrait_view_width - (portrait_gutter * 2), max(760px, portrait_view_width * 0.84));
    private property <length> portrait_authenticated_height: min(portrait_view_height - (portrait_gutter * 2), max(1180px, portrait_view_height * 0.72));
    private property <length> landscape_shortcut_width: max(190px, 220px * landscape_scene_scale);
    private property <length> landscape_shortcut_height: max(78px, 88px * landscape_scene_scale);
    private property <length> portrait_shortcut_width: max(170px, 190px * portrait_scene_scale);
    private property <length> portrait_shortcut_height: max(74px, 82px * portrait_scene_scale);
    private property <length> landscape_settings_width: min(landscape_view_width - (landscape_gutter * 2), max(480px, min(landscape_view_width * 0.40, 620px)));
    private property <length> landscape_settings_height: min(landscape_view_height - (landscape_gutter * 2), max(800px, landscape_view_height * 0.92));
    private property <length> portrait_settings_width: portrait_view_width - (portrait_gutter * 2);
    private property <length> portrait_settings_height: portrait_view_height - (portrait_gutter * 2);
    private property <color> bg_start: is_light_theme ? #eef4fa : (is_high_contrast ? #040b14 : #07111f);
    private property <color> bg_end: is_light_theme ? #d9e6f3 : (is_high_contrast ? #09101b : #0d1728);
    private property <color> surface_fill: is_light_theme ? #f7fbff : (is_low_contrast ? #102133 : #0d1a2d);
    private property <color> surface_alt_fill: is_light_theme ? #edf4fb : (is_low_contrast ? #12263a : #091523);
    private property <color> surface_stroke: is_light_theme ? #b4c8db : (is_high_contrast ? #486788 : #243b59);
    private property <color> accent_fill: #f4ab2a;
    private property <color> accent_pressed_fill: #d69718;
    private property <color> accent_text: #09111f;
    private property <color> primary_text: is_light_theme ? #102033 : #f8fbff;
    private property <color> secondary_text: is_light_theme ? #4a6582 : #8fa5c1;
    private property <color> tertiary_text: is_light_theme ? #627c97 : #7f97b5;
    private property <color> muted_text: is_light_theme ? #7890aa : #6f87a5;
    private property <color> panel_button_fill: is_light_theme ? #dfeaf5 : #132439;
    private property <color> panel_button_pressed_fill: is_light_theme ? #cddfed : #24415f;
    private property <color> panel_button_stroke: is_light_theme ? #98b3ca : #35506f;
    private property <color> error_fill: is_light_theme ? #fff0f1 : #2b151a;
    private property <color> error_stroke: is_light_theme ? #da9ea6 : #8f434a;
    private property <color> error_text: is_light_theme ? #9d3744 : #ffd2d6;
    private property <color> blocked_bar_fill: fatal_error != "" ? #d96c73 : accent_fill;
    private property <color> blocked_body_color: fatal_error != "" ? error_text : secondary_text;
    private property <color> backdrop_primary: is_light_theme ? #c7dced33 : #10243a55;
    private property <color> backdrop_secondary: is_light_theme ? #a8c4dd30 : #18335444;
    private property <color> overlay_fill: is_light_theme ? #dce7f080 : #02070db0;

    background: @linear-gradient(180deg, bg_start 0%, bg_end 100%);

    landscape_scene := Rectangle {
        visible: root.is_landscape;
        x: 0px;
        y: 0px;
        width: root.landscape_view_width;
        height: root.landscape_view_height;
        background: transparent;
        transform-rotation: root.landscape_rotation;
        transform-origin: { x: self.width / 2, y: self.height / 2 };

        SceneBackdrop {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            primary_blob: root.backdrop_primary;
            secondary_blob: root.backdrop_secondary;
        }

        BlockedScreen {
            visible: root.blocked_visible && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            title_text: root.blocked_title_text;
            body_text: root.blocked_body_text;
            footer_text: root.blocked_footer_text;
            fill: root.surface_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            body_color: root.blocked_body_color;
            footer_color: root.muted_text;
            bar_fill: root.blocked_bar_fill;
        }

        LoginScreen {
            visible: root.login_visible && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            pin_display: root.pin_display;
            error_message: root.error_message;
            active: root.auth_status == 2;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            accent_fill: root.accent_fill;
            error_fill: root.error_fill;
            error_stroke: root.error_stroke;
            error_text: root.error_text;
            append_digit(digit) => {
                root.append_digit(digit);
            }
            clear_requested => {
                root.clear_pin();
            }
            back_requested => {
                root.backspace();
            }
        }

        AuthenticatedScreen {
            visible: root.authenticated_visible && !root.demo_mode_enabled && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            driver_label: root.authenticated_driver_label;
            current_time_text: root.current_time_text;
            light_theme: root.is_light_theme;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            logout_requested => {
                root.logout();
            }
        }

        DemoBoardingScreen {
            visible: root.authenticated_visible && root.demo_mode_enabled && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            driver_label: root.authenticated_driver_label;
            current_time_text: root.current_time_text;
            light_theme: root.is_light_theme;
            demo_status_title: root.demo_status_title;
            demo_status_body: root.demo_status_body;
            demo_total_count: root.demo_total_count;
            demo_seat_names: root.demo_seat_names;
            demo_seat_grades: root.demo_seat_grades;
            demo_seat_states: root.demo_seat_states;
            demo_alert_kind: root.demo_alert_kind;
            demo_toast_visible: root.demo_toast_visible;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            logout_requested => {
                root.logout();
            }
        }

        ScreenShortcut {
            visible: !root.is_settings_open && !root.blocked_visible && (root.login_visible || (root.authenticated_visible && !root.demo_mode_enabled));
            x: parent.width - self.width - root.landscape_gutter;
            y: root.landscape_gutter;
            width: root.landscape_shortcut_width;
            height: root.landscape_shortcut_height;
            subtitle: root.orientation_label;
            active: true;
            scale: root.landscape_scene_scale;
            fill: root.panel_button_fill;
            pressed_fill: root.panel_button_pressed_fill;
            stroke: root.panel_button_stroke;
            text_color: root.primary_text;
            subtitle_color: root.tertiary_text;
            tapped => {
                root.open_settings();
            }
        }

        SettingsScreen {
            visible: root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            orientation_mode: root.orientation_mode;
            brightness_level: root.brightness_level;
            contrast_level: root.contrast_level;
            theme_mode: root.theme_mode;
            demo_mode_enabled: root.demo_mode_enabled;
            demo_success_tag: root.demo_success_tag;
            demo_wrong_bus_tag: root.demo_wrong_bus_tag;
            demo_invalid_tag: root.demo_invalid_tag;
            demo_capture_slot: root.demo_capture_slot;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            set_orientation(mode) => {
                root.set_orientation(mode);
            }
            set_theme_mode(mode) => {
                root.set_theme_mode(mode);
            }
            adjust_brightness(delta) => {
                root.adjust_brightness(delta);
            }
            adjust_contrast(delta) => {
                root.adjust_contrast(delta);
            }
            set_demo_mode_enabled(enabled) => {
                root.set_demo_mode_enabled(enabled);
            }
            adjust_demo_tag(slot, delta) => {
                root.adjust_demo_tag(slot, delta);
            }
            clear_demo_tag(slot) => {
                root.clear_demo_tag(slot);
            }
            start_demo_tag_capture(slot) => {
                root.start_demo_tag_capture(slot);
            }
            close_requested => {
                root.close_settings();
            }
        }
    }

    portrait_scene := Rectangle {
        visible: root.is_portrait;
        x: (root.width - root.height) / 2;
        y: (root.height - root.width) / 2;
        width: root.portrait_view_width;
        height: root.portrait_view_height;
        background: transparent;
        transform-rotation: root.portrait_rotation;
        transform-origin: { x: self.width / 2, y: self.height / 2 };

        SceneBackdrop {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            primary_blob: root.backdrop_primary;
            secondary_blob: root.backdrop_secondary;
        }

        BlockedScreen {
            visible: root.blocked_visible && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            title_text: root.blocked_title_text;
            body_text: root.blocked_body_text;
            footer_text: root.blocked_footer_text;
            fill: root.surface_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            body_color: root.blocked_body_color;
            footer_color: root.muted_text;
            bar_fill: root.blocked_bar_fill;
        }

        LoginScreen {
            visible: root.login_visible && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            pin_display: root.pin_display;
            error_message: root.error_message;
            active: root.auth_status == 2;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            accent_fill: root.accent_fill;
            error_fill: root.error_fill;
            error_stroke: root.error_stroke;
            error_text: root.error_text;
            append_digit(digit) => {
                root.append_digit(digit);
            }
            clear_requested => {
                root.clear_pin();
            }
            back_requested => {
                root.backspace();
            }
        }

        AuthenticatedScreen {
            visible: root.authenticated_visible && !root.demo_mode_enabled && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            driver_label: root.authenticated_driver_label;
            current_time_text: root.current_time_text;
            light_theme: root.is_light_theme;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            logout_requested => {
                root.logout();
            }
        }

        DemoBoardingScreen {
            visible: root.authenticated_visible && root.demo_mode_enabled && !root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            driver_label: root.authenticated_driver_label;
            current_time_text: root.current_time_text;
            light_theme: root.is_light_theme;
            demo_status_title: root.demo_status_title;
            demo_status_body: root.demo_status_body;
            demo_total_count: root.demo_total_count;
            demo_seat_names: root.demo_seat_names;
            demo_seat_grades: root.demo_seat_grades;
            demo_seat_states: root.demo_seat_states;
            demo_alert_kind: root.demo_alert_kind;
            demo_toast_visible: root.demo_toast_visible;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            trigger_demo_scan(outcome) => {
                root.trigger_demo_scan(outcome);
            }
            logout_requested => {
                root.logout();
            }
        }

        ScreenShortcut {
            visible: !root.is_settings_open && !root.blocked_visible && (root.login_visible || (root.authenticated_visible && !root.demo_mode_enabled));
            x: parent.width - self.width - root.portrait_gutter;
            y: root.portrait_gutter;
            width: root.portrait_shortcut_width;
            height: root.portrait_shortcut_height;
            subtitle: root.orientation_label;
            active: true;
            scale: root.portrait_scene_scale;
            fill: root.panel_button_fill;
            pressed_fill: root.panel_button_pressed_fill;
            stroke: root.panel_button_stroke;
            text_color: root.primary_text;
            subtitle_color: root.tertiary_text;
            tapped => {
                root.open_settings();
            }
        }

        SettingsScreen {
            visible: root.is_settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            orientation_mode: root.orientation_mode;
            brightness_level: root.brightness_level;
            contrast_level: root.contrast_level;
            theme_mode: root.theme_mode;
            demo_mode_enabled: root.demo_mode_enabled;
            demo_success_tag: root.demo_success_tag;
            demo_wrong_bus_tag: root.demo_wrong_bus_tag;
            demo_invalid_tag: root.demo_invalid_tag;
            demo_capture_slot: root.demo_capture_slot;
            fill: root.surface_fill;
            alt_fill: root.surface_alt_fill;
            stroke: root.surface_stroke;
            primary_text: root.primary_text;
            secondary_text: root.secondary_text;
            tertiary_text: root.tertiary_text;
            panel_button_fill: root.panel_button_fill;
            panel_button_pressed_fill: root.panel_button_pressed_fill;
            panel_button_stroke: root.panel_button_stroke;
            accent_fill: root.accent_fill;
            accent_pressed_fill: root.accent_pressed_fill;
            accent_text: root.accent_text;
            set_orientation(mode) => {
                root.set_orientation(mode);
            }
            set_theme_mode(mode) => {
                root.set_theme_mode(mode);
            }
            adjust_brightness(delta) => {
                root.adjust_brightness(delta);
            }
            adjust_contrast(delta) => {
                root.adjust_contrast(delta);
            }
            set_demo_mode_enabled(enabled) => {
                root.set_demo_mode_enabled(enabled);
            }
            adjust_demo_tag(slot, delta) => {
                root.adjust_demo_tag(slot, delta);
            }
            clear_demo_tag(slot) => {
                root.clear_demo_tag(slot);
            }
            start_demo_tag_capture(slot) => {
                root.start_demo_tag_capture(slot);
            }
            close_requested => {
                root.close_settings();
            }
        }
    }

    Rectangle {
        visible: brightness_level < 100;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000;
        opacity: (100 - brightness_level) / 180;
    }

    Rectangle {
        visible: brightness_level > 100;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #ffffff;
        opacity: (brightness_level - 100) / 260;
    }
}

