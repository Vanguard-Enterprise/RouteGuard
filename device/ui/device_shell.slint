    private property <length> screen_padding: max(28px, 36px * content_scale);
    private property <length> panel_width: min(self.width - (screen_padding * 2), max(900px, self.width * 0.72));
    private property <length> panel_height: min(self.height - (screen_padding * 2), max(420px, self.height * 0.52));

    background: transparent;

    BlockedCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
