component KeypadButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: true;
    in property <color> fill: #132439;
    in property <color> pressed_fill: #24415f;
    in property <color> idle_stroke: #35506f;
    in property <color> pressed_stroke: #5f88b7;
    in property <color> disabled_fill: #101b2a;
    in property <color> disabled_stroke: #24384d;
    in property <color> text_color: #f8fbff;
    in property <color> disabled_text_color: #59708d;
    in property <float> scale: 1.0;
    callback tapped();

    border-radius: 22px * scale;
    border-width: max(1px, scale * 1px);
    border-color: active ? (touch.pressed ? pressed_stroke : idle_stroke) : disabled_stroke;
    background: active ? (touch.pressed ? pressed_fill : fill) : disabled_fill;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: label;
        color: active ? text_color : disabled_text_color;
        font-size: 34px * parent.scale;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        clicked => {
            root.tapped();
        }
    }
}

component PrimaryAction inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: true;
    in property <color> fill: #f4ab2a;
    in property <color> pressed_fill: #d69718;
    in property <color> disabled_fill: #4d3d1e;
    in property <color> stroke: #f0b84a;
    in property <color> disabled_stroke: #6a5830;
    in property <color> text_color: #09111f;
    in property <float> scale: 1.0;
    callback tapped();

    border-radius: 24px * scale;
    border-width: max(1px, scale * 1px);
    border-color: active ? stroke : disabled_stroke;
    background: active ? (touch.pressed ? pressed_fill : fill) : disabled_fill;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: label;
        color: text_color;
        font-size: 24px * parent.scale;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        clicked => {
            root.tapped();
        }
    }
}

component OptionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> active: true;
    in property <color> selected_fill: #f4ab2a;
    in property <color> selected_text: #09111f;
    in property <color> fill: #132439;
    in property <color> stroke: #36516f;
    in property <color> text_color: #f8fbff;
    in property <color> disabled_fill: #101b2a;
    in property <color> disabled_stroke: #24384d;
    in property <color> disabled_text: #59708d;
    in property <float> scale: 1.0;
    callback tapped();

    border-radius: 18px * scale;
    border-width: max(1px, scale * 1px);
    border-color: selected ? selected_fill : (active ? stroke : disabled_stroke);
    background: selected ? selected_fill : (active ? fill : disabled_fill);

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: label;
        color: selected ? selected_text : (active ? text_color : disabled_text);
        font-size: 18px * parent.scale;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        clicked => {
            root.tapped();
        }
    }
}

component SettingStepper inherits Rectangle {
    in property <string> label: "";
    in property <string> value_text: "";
    in property <float> scale: 1.0;
    in property <color> panel_fill: #0f1b2d;
    in property <color> panel_stroke: #28425f;
    in property <color> title_color: #8fa5c1;
    in property <color> value_color: #f8fbff;
    in property <color> button_fill: #132439;
    in property <color> button_pressed_fill: #24415f;
    in property <color> button_stroke: #35506f;
    in property <color> button_text_color: #f8fbff;
    callback decrease();
    callback increase();

    background: panel_fill;
    border-color: panel_stroke;
    border-width: max(1px, scale * 1px);
    border-radius: 24px * scale;

    Text {
        x: 24px * parent.scale;
        y: 18px * parent.scale;
        text: label;
        color: title_color;
        font-size: 16px * parent.scale;
        font-weight: 700;
    }

    Text {
        x: 24px * parent.scale;
        y: 44px * parent.scale;
        width: parent.width - (48px * parent.scale);
        text: value_text;
        color: value_color;
        font-size: 28px * parent.scale;
        font-weight: 800;
    }

    Rectangle {
        x: parent.width - (136px * parent.scale);
        y: (parent.height - (52px * parent.scale)) / 2;
        width: 52px * parent.scale;
        height: 52px * parent.scale;
        border-radius: 16px * parent.scale;
        border-width: max(1px, parent.scale * 1px);
        border-color: root.button_stroke;
        background: dec_touch.pressed ? root.button_pressed_fill : root.button_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "-";
            color: root.button_text_color;
            font-size: 28px * root.scale;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        dec_touch := TouchArea {
            clicked => {
                root.decrease();
            }
        }
    }

    Rectangle {
        x: parent.width - (72px * parent.scale);
        y: (parent.height - (52px * parent.scale)) / 2;
        width: 52px * parent.scale;
        height: 52px * parent.scale;
        border-radius: 16px * parent.scale;
        border-width: max(1px, parent.scale * 1px);
        border-color: root.button_stroke;
        background: inc_touch.pressed ? root.button_pressed_fill : root.button_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "+";
            color: root.button_text_color;
            font-size: 28px * root.scale;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        inc_touch := TouchArea {
            clicked => {
                root.increase();
            }
        }
    }
}

component ScreenShortcut inherits Rectangle {
    in property <string> subtitle: "";
    in property <bool> active: true;
    in property <float> scale: 1.0;
    in property <color> fill: #132439;
    in property <color> pressed_fill: #24415f;
    in property <color> stroke: #35506f;
    in property <color> text_color: #f8fbff;
    in property <color> subtitle_color: #7f97b5;
    callback tapped();

    border-radius: 24px * scale;
    border-width: max(1px, scale * 1px);
    border-color: stroke;
    background: touch.pressed ? pressed_fill : fill;

    Text {
        x: 0px;
        y: 10px * root.scale;
        width: parent.width;
        text: "Screen";
        color: text_color;
        font-size: 22px * root.scale;
        font-weight: 800;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: parent.height - (28px * root.scale);
        width: parent.width;
        text: subtitle;
        color: subtitle_color;
        font-size: 16px * root.scale;
        font-weight: 600;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        clicked => {
            root.tapped();
        }
    }
}

component PinKeypad inherits GridLayout {
    in property <float> scale: 1.0;
    in property <bool> active: true;
    in property <color> fill: #132439;
    in property <color> pressed_fill: #24415f;
    in property <color> stroke: #35506f;
    in property <color> accent_stroke: #f4ab2a;
    in property <color> text_color: #f8fbff;
    callback append_digit(string);
    callback clear_requested();
    callback back_requested();

    private property <length> gap: max(8px, 12px * scale);

    spacing: gap;

    Row {
        KeypadButton { label: "1"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("1"); } }
        KeypadButton { label: "2"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("2"); } }
        KeypadButton { label: "3"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("3"); } }
    }

    Row {
        KeypadButton { label: "4"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("4"); } }
        KeypadButton { label: "5"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("5"); } }
        KeypadButton { label: "6"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("6"); } }
    }

    Row {
        KeypadButton { label: "7"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("7"); } }
        KeypadButton { label: "8"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("8"); } }
        KeypadButton { label: "9"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("9"); } }
    }

    Row {
        KeypadButton { label: "Clear"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.clear_requested(); } }
        KeypadButton { label: "0"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.append_digit("0"); } }
        KeypadButton { label: "Back"; active: root.active; fill: root.fill; pressed_fill: root.pressed_fill; idle_stroke: root.stroke; pressed_stroke: root.accent_stroke; text_color: root.text_color; scale: root.scale; tapped => { root.back_requested(); } }
    }
}

component LockCard inherits Rectangle {
    in property <string> pin_display: "* * * *";
    in property <string> error_message: "";
    in property <bool> active: true;
    in property <color> fill: #0d1a2d;
    in property <color> alt_fill: #091523;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    in property <color> accent_fill: #f4ab2a;
    in property <color> error_fill: #2b151a;
    in property <color> error_stroke: #8f434a;
    in property <color> error_text: #ffd2d6;
    callback append_digit(string);
    callback clear_requested();
    callback back_requested();

    private property <float> content_scale: max(0.54, min(1.08, min(self.width / 680px, self.height / 900px)));
    private property <length> side_padding: max(24px, 40px * content_scale);
    private property <length> top_padding: max(20px, 28px * content_scale);
    private property <length> logo_width: min(self.width - (side_padding * 2), 330px * content_scale);
    private property <length> logo_height: max(56px, 82px * content_scale);
    private property <length> content_gap: max(16px, 20px * content_scale);
    private property <length> pin_height: max(54px, 62px * content_scale);
    private property <length> error_height: max(56px, 60px * content_scale);
    private property <length> button_gap: max(8px, 12px * content_scale);
    private property <length> button_height: max(54px, 76px * content_scale);
    private property <length> keypad_height: button_height * 4 + button_gap * 3;
    private property <length> error_block_height: error_message != "" ? error_height + content_gap : 0px;
    private property <length> content_height: logo_height + content_gap + pin_height + content_gap + error_block_height + keypad_height;
    private property <length> content_top: max(top_padding, (self.height - content_height) / 2);
    private property <length> pin_top: content_top + logo_height + content_gap;
    private property <length> error_top: pin_top + pin_height + content_gap;
    private property <length> keypad_top: pin_top + pin_height + content_gap + error_block_height;

    background: fill;
    border-color: stroke;
    border-width: max(1px, content_scale * 1px);
    border-radius: 34px * content_scale;

    Image {
        x: (parent.width - root.logo_width) / 2;
        y: root.content_top;
        width: root.logo_width;
        height: root.logo_height;
        source: @image-url("../assets/text-logo.png");
        image-fit: contain;
    }

    Rectangle {
        x: root.side_padding;
        y: root.pin_top;
        width: parent.width - (root.side_padding * 2);
        height: root.pin_height;
        border-radius: 20px * root.content_scale;
        border-width: max(1px, root.content_scale * 1px);
        border-color: error_message != "" ? error_stroke : stroke;
        background: error_message != "" ? error_fill : alt_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: pin_display;
            color: primary_text;
            font-size: 26px * root.content_scale;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        visible: error_message != "";
        x: root.side_padding;
        y: root.error_top;
        width: parent.width - (root.side_padding * 2);
        height: root.error_height;
        border-radius: 20px * root.content_scale;
        border-width: max(1px, root.content_scale * 1px);
        border-color: error_stroke;
        background: error_fill;

        Text {
            x: 20px * root.content_scale;
            y: 0px;
            width: parent.width - (40px * root.content_scale);
            height: parent.height;
            text: error_message;
            color: error_text;
            font-size: 15px * root.content_scale;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    PinKeypad {
        x: root.side_padding;
        y: root.keypad_top;
        width: parent.width - (root.side_padding * 2);
        height: root.keypad_height;
        scale: root.content_scale;
        active: root.active;
        fill: panel_button_fill;
        pressed_fill: panel_button_pressed_fill;
        stroke: panel_button_stroke;
        accent_stroke: accent_fill;
        text_color: primary_text;
        append_digit(digit) => {
            root.append_digit(digit);
        }
        clear_requested => {
            root.clear_requested();
        }
        back_requested => {
            root.back_requested();
        }
    }
}

component BlockedCard inherits Rectangle {
    in property <string> title_text: "";
    in property <string> body_text: "";
    in property <string> footer_text: "";
    in property <color> fill: #0d1a2d;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> body_color: #8fa5c1;
    in property <color> footer_color: #6f87a5;
    in property <color> bar_fill: #f4ab2a;

    private property <float> content_scale: max(0.58, min(1.10, min(self.width / 760px, self.height / 430px)));
    private property <length> side_padding: max(32px, 56px * content_scale);
    private property <length> top_padding: max(28px, 36px * content_scale);
    private property <length> title_height: 54px * content_scale;
    private property <length> body_height: 150px * content_scale;
    private property <length> footer_height: 30px * content_scale;
    private property <length> block_gap: max(18px, 20px * content_scale);
    private property <length> content_height: title_height + block_gap + body_height + block_gap + footer_height;
    private property <length> content_top: max(top_padding, (self.height - content_height) / 2);

    background: fill;
    border-color: stroke;
    border-width: max(1px, content_scale * 1px);
    border-radius: 32px * content_scale;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 8px * root.content_scale;
        background: bar_fill;
    }

    Text {
        x: root.side_padding;
        y: root.content_top;
        width: parent.width - (root.side_padding * 2);
        height: root.title_height;
        text: title_text;
        color: primary_text;
        font-size: 42px * root.content_scale;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: root.side_padding;
        y: root.content_top + root.title_height + root.block_gap;
        width: parent.width - (root.side_padding * 2);
        height: root.body_height;
        text: body_text;
        color: body_color;
        font-size: 22px * root.content_scale;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    Text {
        x: root.side_padding;
        y: root.content_top + root.title_height + root.block_gap + root.body_height + root.block_gap;
        width: parent.width - (root.side_padding * 2);
        height: root.footer_height;
        text: footer_text;
        color: footer_color;
        font-size: 18px * root.content_scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BusSeatCard inherits Rectangle {
    in property <string> name_text: "";
    in property <string> grade_text: "";
    in property <string> seat_label: "";
    in property <int> seat_state: 0;
    in property <float> scale: 1.0;
    in property <color> stroke: #d7e1ee;
    in property <color> dark_fill: #16213a;
    in property <color> dark_text: #f8fbff;
    in property <color> light_text: #16213a;
    in property <color> muted_text: #8da2bf;
    in property <color> success_fill: #dff4e8;
    in property <color> success_text: #1f6a49;
    in property <color> waiting_fill: #eef2f8;
    in property <color> waiting_text: #526583;
    in property <color> absent_fill: #fbe1e7;
    in property <color> absent_text: #b94d68;

    private property <bool> seat_open: seat_state == 0;
    private property <bool> seat_boarded: seat_state == 1;
    private property <bool> seat_waiting: seat_state == 2;
    private property <bool> seat_absent: seat_state == 3;
    private property <string> status_text:
        seat_boarded ? "On bus" :
        seat_waiting ? "Waiting" :
        seat_absent ? "Absent" :
        "Open seat";
    private property <color> card_fill: seat_waiting ? dark_fill : #ffffff;
    private property <color> card_text: seat_waiting ? dark_text : light_text;
    private property <color> grade_color: seat_waiting ? #c2ccdc : muted_text;
    private property <color> pill_fill:
        seat_boarded ? success_fill :
        seat_waiting ? waiting_fill :
        seat_absent ? absent_fill :
        #ffffff;
    private property <color> pill_text:
        seat_boarded ? success_text :
        seat_waiting ? waiting_text :
        seat_absent ? absent_text :
        muted_text;

    background: seat_open ? #f8fbff : card_fill;
    border-color: stroke;
    border-width: max(1px, scale * 1px);
    border-radius: 20px * scale;

    Text {
        visible: !root.seat_open;
        x: 20px * root.scale;
        y: 14px * root.scale;
        width: parent.width - (86px * root.scale);
        text: name_text;
        color: root.card_text;
        font-size: 26px * root.scale;
        font-weight: 800;
    }

    Text {
        visible: !root.seat_open;
        x: 20px * root.scale;
        y: 50px * root.scale;
        width: parent.width - (86px * root.scale);
        text: grade_text;
        color: root.grade_color;
        font-size: 18px * root.scale;
        font-weight: 700;
    }

    Text {
        visible: !root.seat_open;
        x: parent.width - (58px * root.scale);
        y: 16px * root.scale;
        width: 40px * root.scale;
        text: seat_label;
        color: root.muted_text;
        font-size: 17px * root.scale;
        font-weight: 700;
        horizontal-alignment: right;
    }

    Rectangle {
        visible: !root.seat_open;
        x: 18px * root.scale;
        y: parent.height - (54px * root.scale);
        width: parent.width - (36px * root.scale);
        height: 38px * root.scale;
        border-radius: 19px * root.scale;
        background: root.pill_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.status_text;
            color: root.pill_text;
            font-size: 18px * root.scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        visible: root.seat_open;
        x: 0px;
        y: (parent.height - (28px * root.scale)) / 2;
        width: parent.width;
        text: "Open seat";
        color: root.muted_text;
        font-size: 22px * root.scale;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component AuthenticatedCard inherits Rectangle {
    in property <string> driver_label: "";
    in property <string> current_time_text: "";
    in property <bool> light_theme: false;
    in property <bool> demo_mode_enabled: false;
    in property <string> demo_status_title: "";
    in property <string> demo_status_body: "";
    in property <string> demo_success_tag: "";
    in property <string> demo_wrong_bus_tag: "";
    in property <string> demo_invalid_tag: "";
    in property <int> demo_boarded_count: 0;
    in property <int> demo_total_count: 0;
    in property <[string]> demo_students: [];
    in property <[string]> demo_seat_names: [];
    in property <[string]> demo_seat_grades: [];
    in property <[int]> demo_seat_states: [];
    in property <int> demo_alert_kind: 0;
    in property <bool> demo_toast_visible: false;
    in property <color> fill: #0d1a2d;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> secondary_text: #8fa5c1;
    in property <color> tertiary_text: #7f97b5;
    in property <color> accent_fill: #f4ab2a;
    in property <color> accent_pressed_fill: #d69718;
    in property <color> accent_text: #09111f;
    in property <color> alt_fill: #091523;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    callback logout_requested();
    callback trigger_demo_scan(int);

    private property <float> content_scale: max(0.52, min(1.0, min(self.width / 920px, self.height / 680px)));
    private property <length> side_padding: max(24px, 30px * content_scale);
    private property <length> top_padding: max(22px, 28px * content_scale);
    private property <length> header_height: 64px * content_scale;
    private property <length> panel_gap: max(12px, 16px * content_scale);
    private property <length> action_height: max(54px, 60px * content_scale);
    private property <length> footer_width: max(180px, 220px * content_scale);
    private property <length> seat_panel_top: top_padding + header_height + panel_gap;
    private property <length> seat_panel_height: max(360px, self.height - seat_panel_top - action_height - (side_padding * 2) - panel_gap);
    private property <length> scan_row_top: seat_panel_top + seat_panel_height + panel_gap;
    private property <length> scan_button_width: (self.width - (side_padding * 2) - (panel_gap * 3) - footer_width) / 3;
    private property <length> seat_panel_width: self.width - (side_padding * 2);
    private property <length> seat_column_width: (seat_panel_width - (120px * content_scale)) / 2;
    private property <length> seat_gap: 14px * content_scale;
    private property <length> seat_height: 128px * content_scale;
    private property <string> boarding_summary: demo_total_count + " waiting";
    private property <color> alert_color:
        demo_alert_kind == 1 ? #2bb673 :
        demo_alert_kind == 2 ? #e25555 :
        demo_alert_kind == 3 ? #3f8cff :
        accent_fill;
    private property <color> muted_text: #8da2bf;

    background: fill;
    border-color: stroke;
    border-width: max(1px, content_scale * 1px);
    border-radius: 34px * content_scale;

    Rectangle {
        visible: !root.demo_mode_enabled;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        Rectangle {
            x: (parent.width - (112px * root.content_scale)) / 2;
            y: root.top_padding;
            width: 112px * root.content_scale;
            height: 112px * root.content_scale;
            border-radius: self.width / 2;
            background: light_theme ? #d8f0df : #173520;
            border-width: max(2px, root.content_scale * 2px);
            border-color: #2b8a57;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "OK";
                color: light_theme ? #1f5a35 : #dff9e7;
                font-size: 32px * root.content_scale;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: root.side_padding;
            y: 152px * root.content_scale;
            width: parent.width - (root.side_padding * 2);
            text: "Driver authenticated";
            color: root.primary_text;
            font-size: 40px * root.content_scale;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            x: root.side_padding;
            y: 208px * root.content_scale;
            width: parent.width - (root.side_padding * 2);
            text: root.driver_label;
            color: root.accent_fill;
            font-size: 28px * root.content_scale;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            x: root.side_padding;
            y: 268px * root.content_scale;
            width: parent.width - (root.side_padding * 2);
            text: "Demo mode off. Standard route and scan surfaces still live in later Slint phases.";
            color: root.secondary_text;
            font-size: 20px * root.content_scale;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        visible: root.demo_mode_enabled;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        Text {
            x: root.side_padding;
            y: root.top_padding + (4px * root.content_scale);
            width: 170px * root.content_scale;
            height: 32px * root.content_scale;
            text: root.current_time_text;
            color: root.primary_text;
            font-size: 26px * root.content_scale;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            x: (parent.width - (180px * root.content_scale)) / 2;
            y: root.top_padding + (8px * root.content_scale);
            width: 180px * root.content_scale;
            text: root.boarding_summary;
            color: root.secondary_text;
            font-size: 20px * root.content_scale;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Rectangle {
            visible: root.demo_toast_visible;
            x: root.side_padding;
            y: root.top_padding + (50px * root.content_scale);
            width: parent.width - (root.side_padding * 2);
            height: 58px * root.content_scale;
            border-radius: 18px * root.content_scale;
            border-width: max(1px, root.content_scale * 1px);
            border-color: root.alert_color;
            background: light_theme ? #f8fbff : #122038;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 8px * root.content_scale;
                height: parent.height;
                border-radius: 18px * root.content_scale;
                background: root.alert_color;
            }

            Text {
                x: 22px * root.content_scale;
                y: 10px * root.content_scale;
                width: parent.width - (44px * root.content_scale);
                text: root.demo_status_title;
                color: root.primary_text;
                font-size: 16px * root.content_scale;
                font-weight: 800;
            }

            Text {
                x: 22px * root.content_scale;
                y: 30px * root.content_scale;
                width: parent.width - (44px * root.content_scale);
                text: root.demo_status_body;
                color: root.secondary_text;
                font-size: 13px * root.content_scale;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: root.side_padding;
            y: root.seat_panel_top;
            width: root.seat_panel_width;
            height: root.seat_panel_height;
            border-radius: 30px * root.content_scale;
            border-width: max(1px, root.content_scale * 1px);
            border-color: light_theme ? #d7e1ee : root.panel_button_stroke;
            background: light_theme ? #f3f7fc : root.alt_fill;

            Rectangle {
                x: (parent.width - (4px * root.content_scale)) / 2;
                y: 18px * root.content_scale;
                width: 2px * root.content_scale;
                height: parent.height - (36px * root.content_scale);
                background: light_theme ? #d7e1ee : root.panel_button_stroke;
            }

            for row in [0, 1, 2, 3, 4] : Text {
                x: (parent.width - (24px * root.content_scale)) / 2;
                y: 42px * root.content_scale + (row * (root.seat_height + root.seat_gap));
                width: 24px * root.content_scale;
                text: row + 1;
                color: root.muted_text;
                font-size: 16px * root.content_scale;
                font-weight: 700;
                horizontal-alignment: center;
            }

            for seat[index] in root.demo_seat_names : BusSeatCard {
                x: index < 5 ?
                    18px * root.content_scale :
                    parent.width - root.seat_column_width - (18px * root.content_scale);
                y: 18px * root.content_scale + (Math.mod(index, 5) * (root.seat_height + root.seat_gap));
                width: root.seat_column_width;
                height: root.seat_height;
                name_text: seat;
                grade_text: root.demo_seat_grades[index];
                seat_state: root.demo_seat_states[index];
                seat_label: index < 5 ? (index + 1) + "A" : (index - 4) + "B";
                scale: root.content_scale;
                stroke: light_theme ? #d7e1ee : root.panel_button_stroke;
                dark_fill: #16213a;
                dark_text: #f8fbff;
                light_text: light_theme ? #16213a : #f8fbff;
                muted_text: root.muted_text;
                success_fill: #dff4e8;
                success_text: #1f6a49;
                waiting_fill: light_theme ? #31384d : #2f3850;
                waiting_text: #f8fbff;
                absent_fill: #fbe1e7;
                absent_text: #b94d68;
            }
        }

    }

    PrimaryAction {
        x: parent.width - root.footer_width - root.side_padding;
        y: parent.height - self.height - root.side_padding;
        width: root.footer_width;
        height: root.action_height;
        label: "Logout";
        active: true;
        fill: accent_fill;
        pressed_fill: accent_pressed_fill;
        stroke: accent_fill;
        text_color: accent_text;
        scale: root.content_scale;
        tapped => {
            root.logout_requested();
        }
    }
}

component DemoTagAdjuster inherits Rectangle {
    in property <string> label: "";
    in property <string> value_text: "";
    in property <bool> capture_active: false;
    in property <float> scale: 1.0;
    in property <color> fill: #0f1b2d;
    in property <color> stroke: #28425f;
    in property <color> title_color: #8fa5c1;
    in property <color> value_color: #f8fbff;
    in property <color> button_fill: #132439;
    in property <color> button_pressed_fill: #24415f;
    in property <color> button_stroke: #35506f;
    in property <color> button_text_color: #f8fbff;
    callback scan_requested();
    callback clear_requested();

    background: capture_active ? button_pressed_fill : fill;
    border-color: capture_active ? value_color : stroke;
    border-width: max(1px, scale * 1px);
    border-radius: 20px * scale;

    Text {
        x: 76px * parent.scale;
        y: 12px * parent.scale;
        text: label;
        color: title_color;
        font-size: 14px * parent.scale;
        font-weight: 700;
    }

    Text {
        x: 76px * parent.scale;
        y: 32px * parent.scale;
        width: parent.width - (152px * parent.scale);
        text: capture_active ? (value_text == "" ? "Scanning..." : value_text) : (value_text == "" ? "Not set" : value_text);
        color: value_color;
        font-size: 22px * parent.scale;
        font-weight: 800;
    }

    Rectangle {
        x: 16px * parent.scale;
        y: (parent.height - (40px * parent.scale)) / 2;
        width: 40px * parent.scale;
        height: 40px * parent.scale;
        border-radius: 12px * parent.scale;
        border-width: max(1px, parent.scale * 1px);
        border-color: root.button_stroke;
        background: scan_touch.pressed || root.capture_active ? root.button_pressed_fill : root.button_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "S";
            color: root.button_text_color;
            font-size: 24px * root.scale;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        scan_touch := TouchArea {
            clicked => {
                root.scan_requested();
            }
        }
    }

    Rectangle {
        x: parent.width - (56px * parent.scale);
        y: (parent.height - (40px * parent.scale)) / 2;
        width: 40px * parent.scale;
        height: 40px * parent.scale;
        border-radius: 12px * parent.scale;
        border-width: max(1px, parent.scale * 1px);
        border-color: root.button_stroke;
        background: clear_touch.pressed ? root.button_pressed_fill : root.button_fill;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "X";
            color: root.button_text_color;
            font-size: 24px * root.scale;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        clear_touch := TouchArea {
            clicked => {
                root.clear_requested();
            }
        }
    }
}

component SceneBackdrop inherits Rectangle {
    in property <color> primary_blob: #10243a55;
    in property <color> secondary_blob: #18335444;

    background: transparent;

    Rectangle {
        x: -root.width * 0.10;
        y: -root.height * 0.16;
        width: root.width * 0.46;
        height: root.width * 0.46;
        border-radius: root.width * 0.23;
        background: primary_blob;
    }

    Rectangle {
        x: root.width * 0.72;
        y: root.height * 0.63;
        width: root.width * 0.30;
        height: root.width * 0.30;
        border-radius: root.width * 0.15;
        background: secondary_blob;
    }
}

component SettingsPanel inherits Rectangle {
    in property <int> orientation_mode: 0;
    in property <int> brightness_level: 100;
    in property <int> contrast_level: 100;
    in property <int> theme_mode: 0;
    in property <bool> demo_mode_enabled: false;
    in property <string> demo_success_tag: "";
    in property <string> demo_wrong_bus_tag: "";
    in property <string> demo_invalid_tag: "";
    in property <int> demo_capture_slot: -1;
    in property <color> fill: #0d1a2d;
    in property <color> alt_fill: #091523;
    in property <color> stroke: #243b59;
    in property <color> primary_text: #f8fbff;
    in property <color> secondary_text: #8fa5c1;
    in property <color> tertiary_text: #7f97b5;
    in property <color> panel_button_fill: #132439;
    in property <color> panel_button_pressed_fill: #24415f;
    in property <color> panel_button_stroke: #35506f;
    in property <color> accent_fill: #f4ab2a;
    in property <color> accent_pressed_fill: #d69718;
    in property <color> accent_text: #09111f;
    callback set_orientation(int);
    callback set_theme_mode(int);
    callback adjust_brightness(int);
    callback adjust_contrast(int);
    callback set_demo_mode_enabled(bool);
    callback adjust_demo_tag(int, int);
    callback clear_demo_tag(int);
    callback start_demo_tag_capture(int);
    callback close_requested();

    private property <float> panel_scale: max(0.58, min(0.94, min(self.width / 620px, self.height / 760px)));
    private property <length> side_padding: max(18px, 22px * panel_scale);
    private property <length> top_padding: max(18px, 20px * panel_scale);
    private property <length> row_gap: max(6px, 8px * panel_scale);
    private property <length> section_gap: max(10px, 12px * panel_scale);
    private property <length> option_height: max(42px, 46px * panel_scale);
    private property <length> stepper_height: max(62px, 66px * panel_scale);
    private property <length> demo_row_height: max(48px, 52px * panel_scale);
    private property <length> footer_height: max(46px, 48px * panel_scale);
    private property <length> option_width: (self.width - (side_padding * 2) - row_gap) / 2;
    private property <length> subtitle_top: top_padding + (32px * panel_scale);
    private property <length> orientation_label_top: top_padding + (74px * panel_scale);
    private property <length> orientation_row1_top: top_padding + (96px * panel_scale);
    private property <length> orientation_row2_top: orientation_row1_top + option_height + row_gap;
    private property <length> appearance_label_top: orientation_row2_top + option_height + section_gap;
    private property <length> theme_row_top: appearance_label_top + (22px * panel_scale);
    private property <length> brightness_top: theme_row_top + option_height + section_gap;
    private property <length> contrast_top: brightness_top + stepper_height + row_gap;
    private property <length> demo_label_top: contrast_top + stepper_height + section_gap;
    private property <length> demo_toggle_top: demo_label_top + (18px * panel_scale);
    private property <length> demo_tag_1_top: demo_toggle_top + option_height + row_gap;
    private property <length> demo_tag_2_top: demo_tag_1_top + demo_row_height + row_gap;
    private property <length> demo_tag_3_top: demo_tag_2_top + demo_row_height + row_gap;

    background: fill;
    border-color: stroke;
    border-width: max(2px, panel_scale * 1px);
    border-radius: 30px * panel_scale;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 8px * root.panel_scale;
        background: accent_fill;
        border-radius: 30px * root.panel_scale;
    }

    Text {
        x: root.side_padding;
        y: root.top_padding;
        text: "Screen settings";
        color: primary_text;
        font-size: 24px * root.panel_scale;
        font-weight: 800;
    }

    Text {
        x: root.side_padding;
        y: root.subtitle_top;
        width: parent.width - (root.side_padding * 2);
        text: "Adjust lock screen and demo behavior before driver login. Settings stay on this device.";
        color: secondary_text;
        font-size: 13px * root.panel_scale;
        wrap: word-wrap;
    }

    Text {
        x: root.side_padding;
        y: root.orientation_label_top;
        text: "Orientation";
        color: tertiary_text;
        font-size: 16px * root.panel_scale;
        font-weight: 700;
    }

    OptionButton {
        x: root.side_padding;
        y: root.orientation_row1_top;
        width: root.option_width;
        height: root.option_height;
        label: "Landscape";
        selected: orientation_mode == 0;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_orientation(0);
        }
    }

    OptionButton {
        x: parent.width - root.side_padding - root.option_width;
        y: root.orientation_row1_top;
        width: root.option_width;
        height: root.option_height;
        label: "Portrait";
        selected: orientation_mode == 1;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_orientation(1);
        }
    }

    OptionButton {
        x: root.side_padding;
        y: root.orientation_row2_top;
        width: root.option_width;
        height: root.option_height;
        label: "Land. Invert";
        selected: orientation_mode == 2;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_orientation(2);
        }
    }

    OptionButton {
        x: parent.width - root.side_padding - root.option_width;
        y: root.orientation_row2_top;
        width: root.option_width;
        height: root.option_height;
        label: "Port. Invert";
        selected: orientation_mode == 3;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_orientation(3);
        }
    }

    Text {
        x: root.side_padding;
        y: root.appearance_label_top;
        text: "Appearance";
        color: tertiary_text;
        font-size: 16px * root.panel_scale;
        font-weight: 700;
    }

    OptionButton {
        x: root.side_padding;
        y: root.theme_row_top;
        width: root.option_width;
        height: root.option_height;
        label: "Dark";
        selected: theme_mode == 0;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_theme_mode(0);
        }
    }

    OptionButton {
        x: parent.width - root.side_padding - root.option_width;
        y: root.theme_row_top;
        width: root.option_width;
        height: root.option_height;
        label: "Light";
        selected: theme_mode == 1;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_theme_mode(1);
        }
    }

    SettingStepper {
        x: root.side_padding;
        y: root.brightness_top;
        width: parent.width - (root.side_padding * 2);
        height: root.stepper_height;
        label: "Brightness";
        value_text: brightness_level + "%";
        scale: root.panel_scale;
        panel_fill: alt_fill;
        panel_stroke: stroke;
        title_color: tertiary_text;
        value_color: primary_text;
        button_fill: panel_button_fill;
        button_pressed_fill: panel_button_pressed_fill;
        button_stroke: panel_button_stroke;
        button_text_color: primary_text;
        decrease => {
            root.adjust_brightness(-10);
        }
        increase => {
            root.adjust_brightness(10);
        }
    }

    SettingStepper {
        x: root.side_padding;
        y: root.contrast_top;
        width: parent.width - (root.side_padding * 2);
        height: root.stepper_height;
        label: "Contrast";
        value_text: contrast_level + "%";
        scale: root.panel_scale;
        panel_fill: alt_fill;
        panel_stroke: stroke;
        title_color: tertiary_text;
        value_color: primary_text;
        button_fill: panel_button_fill;
        button_pressed_fill: panel_button_pressed_fill;
        button_stroke: panel_button_stroke;
        button_text_color: primary_text;
        decrease => {
            root.adjust_contrast(-10);
        }
        increase => {
            root.adjust_contrast(10);
        }
    }

    Text {
        x: root.side_padding;
        y: root.demo_label_top;
        text: "Demo Mode";
        color: tertiary_text;
        font-size: 14px * root.panel_scale;
        font-weight: 700;
    }

    OptionButton {
        x: root.side_padding;
        y: root.demo_toggle_top;
        width: root.option_width;
        height: root.option_height;
        label: "Off";
        selected: !demo_mode_enabled;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_demo_mode_enabled(false);
        }
    }

    OptionButton {
        x: parent.width - root.side_padding - root.option_width;
        y: root.demo_toggle_top;
        width: root.option_width;
        height: root.option_height;
        label: "On";
        selected: demo_mode_enabled;
        selected_fill: accent_fill;
        selected_text: accent_text;
        fill: panel_button_fill;
        stroke: panel_button_stroke;
        text_color: primary_text;
        scale: root.panel_scale;
        tapped => {
            root.set_demo_mode_enabled(true);
        }
    }

    DemoTagAdjuster {
        x: root.side_padding;
        y: root.demo_tag_1_top;
        width: parent.width - (root.side_padding * 2);
        height: root.demo_row_height;
        label: "Successful Scan Tag";
        value_text: demo_success_tag;
        capture_active: demo_capture_slot == 0;
        scale: root.panel_scale;
        fill: alt_fill;
        stroke: stroke;
        title_color: tertiary_text;
        value_color: primary_text;
        button_fill: panel_button_fill;
        button_pressed_fill: panel_button_pressed_fill;
        button_stroke: panel_button_stroke;
        button_text_color: primary_text;
        scan_requested => {
            root.start_demo_tag_capture(0);
        }
        clear_requested => {
            root.clear_demo_tag(0);
        }
    }

    DemoTagAdjuster {
        x: root.side_padding;
        y: root.demo_tag_2_top;
        width: parent.width - (root.side_padding * 2);
        height: root.demo_row_height;
        label: "Wrong Bus Tag";
        value_text: demo_wrong_bus_tag;
        capture_active: demo_capture_slot == 1;
        scale: root.panel_scale;
        fill: alt_fill;
        stroke: stroke;
        title_color: tertiary_text;
        value_color: primary_text;
        button_fill: panel_button_fill;
        button_pressed_fill: panel_button_pressed_fill;
        button_stroke: panel_button_stroke;
        button_text_color: primary_text;
        scan_requested => {
            root.start_demo_tag_capture(1);
        }
        clear_requested => {
            root.clear_demo_tag(1);
        }
    }

    DemoTagAdjuster {
        x: root.side_padding;
        y: root.demo_tag_3_top;
        width: parent.width - (root.side_padding * 2);
        height: root.demo_row_height;
        label: "Invalid Scan Tag";
        value_text: demo_invalid_tag;
        capture_active: demo_capture_slot == 2;
        scale: root.panel_scale;
        fill: alt_fill;
        stroke: stroke;
        title_color: tertiary_text;
        value_color: primary_text;
        button_fill: panel_button_fill;
        button_pressed_fill: panel_button_pressed_fill;
        button_stroke: panel_button_stroke;
        button_text_color: primary_text;
        scan_requested => {
            root.start_demo_tag_capture(2);
        }
        clear_requested => {
            root.clear_demo_tag(2);
        }
    }

    PrimaryAction {
        x: root.side_padding;
        y: parent.height - self.height - root.side_padding;
        width: parent.width - (root.side_padding * 2);
        height: root.footer_height;
        label: "Close";
        active: true;
        fill: accent_fill;
        pressed_fill: accent_pressed_fill;
        stroke: accent_fill;
        text_color: accent_text;
        scale: root.panel_scale;
        tapped => {
            root.close_requested();
        }
    }
}

component BlockedScreen inherits Rectangle {
