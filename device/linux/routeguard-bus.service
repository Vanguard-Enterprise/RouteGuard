[Unit]
Description=RouteGuard Bus Device
After=network-online.target graphical.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=eglfs
ExecStart=/opt/routeguard-bus/routeguard-bus
Restart=always
RestartSec=3
User=routeguard
SupplementaryGroups=video render input
WorkingDirectory=/opt/routeguard-bus
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
