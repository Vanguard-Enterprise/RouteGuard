[Unit]
Description=RouteGuard Bus Device
After=systemd-user-sessions.service systemd-udev-trigger.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/opt/routeguard-bus/eglfs-kms.json
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_LOGGING_RULES=qt.qpa.eglfs.kms=true
Environment=QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/event20
Environment=QT_QPA_EVDEV_MOUSE_PARAMETERS=/dev/input/event21
Environment=QTWEBENGINE_DISABLE_SANDBOX=1
Environment="QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox --disable-gpu-sandbox"
ExecStart=/opt/routeguard-bus/routeguard-bus-slint
Restart=always
RestartSec=3
User=routeguard
SupplementaryGroups=video render input
WorkingDirectory=/opt/routeguard-bus
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
