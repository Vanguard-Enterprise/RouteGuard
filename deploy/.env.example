# Database
POSTGRES_DB=routeguard
POSTGRES_USER=routeguard
POSTGRES_PASSWORD=changeme_strong_password

# Redis
REDIS_PASSWORD=changeme_strong_password

# Encryption keys — generate with: openssl rand -hex 32
# SESSION_ENCRYPTION_KEY is used to encrypt session payloads stored in Redis
SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars

# DATA_ENCRYPTION_KEY is used to encrypt sensitive DB columns (phone numbers, medical notes, etc.)
DATA_ENCRYPTION_KEY=replace_with_64_hex_chars

# Twilio (SMS notifications to guardians)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Mapbox (maps in dashboard)
MAPBOX_TOKEN=pk.xxxxxxxx

# Dashboard (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MAPBOX_TOKEN=

# Traefik / Let's Encrypt
ACME_EMAIL=
